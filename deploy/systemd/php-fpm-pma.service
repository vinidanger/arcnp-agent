# Espelha o php-fpm-hosting.service, mas isolado pro phpMyAdmin. Ver
# deploy/php-fpm/php-fpm-pma.conf para o motivo da separação.

[Unit]
Description=PHP-FPM for phpMyAdmin SSO (Arcnp)
After=network.target

[Service]
Type=notify
ExecStart=/usr/sbin/php-fpm --nodaemonize --fpm-config /etc/php-fpm-pma.conf
ExecReload=/bin/kill -USR2 $MAINPID
PrivateTmp=true
RuntimeDirectory=php-fpm-pma
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
