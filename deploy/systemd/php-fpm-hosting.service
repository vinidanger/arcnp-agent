# Espelha o php-fpm.service original do sistema, mas como instância
# separada (config própria, PID próprio) — só pras contas de hospedagem
# provisionadas pelo Agent. Ver deploy/php-fpm/php-fpm-hosting.conf para
# o motivo da separação.

[Unit]
Description=PHP-FPM for hosting accounts (Arcnp)
After=network.target

[Service]
Type=notify
ExecStart=/usr/sbin/php-fpm --nodaemonize --fpm-config /etc/php-fpm-hosting.conf
ExecReload=/bin/kill -USR2 $MAINPID
PrivateTmp=true
RuntimeDirectory=php-fpm-hosting
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
