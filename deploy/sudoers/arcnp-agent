# Instalar em /etc/sudoers.d/arcnp-agent (chmod 0440, dono root:root).
#
# Regra de ouro: comandos com argumento fixo ficam pinados por completo
# (ex.: "systemctl reload nginx", não "systemctl *"). Só os scripts
# wrapper abaixo aceitam argumento livre (username/domínio variam por
# conta) — e por isso a validação do argumento é feita DENTRO de cada
# script, nunca confiando no sudoers para isso.
#
# Caminho abaixo assume instalação em /opt/arcnp-agent (ver deploy/README.md).
# Se o caminho de instalação mudar, atualize as linhas abaixo também.

arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/create-hosting-user.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/delete-hosting-user.sh *
arcnpagent ALL=(root) NOPASSWD: /usr/sbin/nginx -t
arcnpagent ALL=(root) NOPASSWD: /usr/bin/systemctl reload nginx
arcnpagent ALL=(root) NOPASSWD: /usr/bin/systemctl reload php-fpm-hosting
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/issue-ssl-certificate.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/renew-ssl-certificates.sh
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/create-addon-directory.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/delete-addon-directory.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/create-backup.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/delete-backup.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/manage-file.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/disk-usage.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/sync-cron.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/manage-ssh.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/manage-dns-zone.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/manage-mail.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/manage-mail-dkim.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/manage-archive.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/tail-log.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/manage-ftp.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/manage-app.sh *
arcnpagent ALL=(root) NOPASSWD: /opt/arcnp-agent/scripts/install-wordpress.sh *

# Uma linha por versão de PHP suportada (config/provisioning.php) — cada
# uma isolada no próprio serviço, reload de uma nunca afeta as outras.
arcnpagent ALL=(root) NOPASSWD: /usr/bin/systemctl reload php81-php-fpm
arcnpagent ALL=(root) NOPASSWD: /usr/bin/systemctl reload php82-php-fpm
arcnpagent ALL=(root) NOPASSWD: /usr/bin/systemctl reload php84-php-fpm
