[Unit]
Description=Arcn Panel PHP-FPM - {{username}}
After=network.target

[Service]
{{zend_ini_scan_dir_line}}
ExecStart={{binary}} --fpm-config {{config_path}} --nodaemonize
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=5
Slice=user-{{uid}}.slice

[Install]
WantedBy=multi-user.target
