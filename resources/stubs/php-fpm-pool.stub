[{{username}}]
user = {{username}}
group = {{username}}

listen = {{socket_path}}
listen.owner = nginx
listen.group = nginx
listen.mode = 0660

pm = ondemand
pm.max_children = 5
pm.process_idle_timeout = 30s

php_admin_value[open_basedir] = {{home_dir}}:/tmp
php_admin_value[upload_tmp_dir] = /tmp
php_admin_value[error_log] = {{home_dir}}/logs/php-error.log
php_admin_flag[log_errors] = on
